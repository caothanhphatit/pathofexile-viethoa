{
  "name": "poe2",
  "version": "1.0.0",
  "description": "Path of Exile Vietnamese tools monorepo: reference web app and POEVH desktop companion.",
  "scripts": {
    "crawl:currency": "node scripts/crawl-currency.mjs",
    "crawl:dictionary": "node scripts/crawl-dictionary.mjs",
    "crawl:items": "node scripts/crawl-items.mjs",
    "crawl:passive-tree": "node scripts/crawl-passive-tree.mjs",
    "crawl:skill-gems": "node scripts/crawl-skill-gems.mjs",
    "crawl:all": "node scripts/crawl-skill-gems.mjs && node scripts/crawl-currency.mjs && node scripts/crawl-items.mjs && node scripts/crawl-passive-tree.mjs",
    "db:migrate": "node src/db/migrate.mjs",
    "fetch:passive-tree-icons": "node scripts/fetch-passive-tree-icons.mjs",
    "export:currency": "node scripts/export-currency.mjs",
    "export:items": "node scripts/export-items.mjs",
    "export:passive-tree": "node scripts/export-passive-tree.mjs",
    "export:skill-gems": "node scripts/export-skill-gems.mjs",
    "export:all": "node scripts/export-skill-gems.mjs && node scripts/export-currency.mjs && node scripts/export-items.mjs && node scripts/export-passive-tree.mjs",
    "extract:game": "node scripts/extract-game.mjs",
    "extract:diff": "node scripts/extract-game-diff.mjs",
    "extract:native": "node scripts/extract-game-native.mjs",
    "extract:web": "node scripts/export-game-web.mjs",
    "translate:content": "node scripts/retranslate-content.mjs",
    "rebuild:data": "node src/db/migrate.mjs && npm run crawl:all && npm run translate:content && npm run export:all",
    "server": "node src/server/index.mjs",
    "site": "node scripts/serve-static.mjs public",
    "test": "node --test",
    "check:pob": "node scripts/check-pob-parity.mjs",
    "dev:spa": "vite --config vite.spa.config.mjs",
    "build:spa": "vite build --config vite.spa.config.mjs",
    "build:css": "tailwindcss -c tailwind.config.cjs -i ./src/styles/app.css -o ./public/dist/app.css --minify",
    "build": "npm run build:css && npm run build:spa",
    "poevh:check": "cargo check --manifest-path apps/poevh-desktop/Cargo.toml --workspace",
    "poevh:test": "cargo test --manifest-path apps/poevh-desktop/Cargo.toml --workspace",
    "poevh:clippy": "cargo clippy --manifest-path apps/poevh-desktop/Cargo.toml --workspace --all-targets -- -D warnings",
    "poevh:build": "cargo build --manifest-path apps/poevh-desktop/Cargo.toml --release",
    "crawl:item-mods": "node scripts/crawl-item-mods.mjs",
    "build:craft-index": "node scripts/build-craft-index.mjs",
    "crawl:craft": "node scripts/crawl-item-mods.mjs && node scripts/build-craft-index.mjs",
    "check:game-data": "node scripts/check-game-data.mjs",
    "extract:game-gems": "node scripts/ggpk/extract-gems.mjs",
    "fill:missing": "node scripts/fill-missing-from-poe2db.mjs",
    "extract:game-base-items": "node scripts/ggpk/extract-base-items.mjs",
    "poevh:publish": "node scripts/publish-poevh.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@fastify/compress": "^8.3.1",
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^11.2.0",
    "cheerio": "^1.2.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.8.5",
    "pg": "^8.21.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
