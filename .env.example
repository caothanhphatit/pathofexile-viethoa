POE2_DATABASE_URL=postgresql://postgres:change-me@localhost:5432/poe2
POE2_LOCALES=vi
PORT=3000
HOST=127.0.0.1
ADMIN_API_TOKEN=change-me
ALLOWED_ORIGINS=http://127.0.0.1:4173,http://localhost:4173
APP_URL=http://127.0.0.1:4173
API_URL=http://127.0.0.1:3000
APP_SESSION_SECRET=change-me-long-random-string
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:3000/api/auth/google/callback
DEV_AUTH_ENABLED=true
# Behind nginx/another proxy: use the visitor IP from X-Forwarded-For
TRUST_PROXY=0
# Ed25519 key for premium licence tokens (base64 PEM). Generate: node scripts/premium-keygen.mjs
PREMIUM_SIGNING_KEY=
# Plans/prices and manual payment details shown in the app and on /premium (JSON, optional)
PREMIUM_OFFER_JSON=
